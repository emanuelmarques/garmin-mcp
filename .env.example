# Chave pessoal gerada em https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=
# Palavra-passe do login OAuth: mínimo 20 caracteres, longa e aleatória
# (é a única defesa real: o limite de tentativas é só por instância)
ACCESS_KEY=
# Segredo para assinar tokens (>= 32 caracteres aleatórios)
SIGNING_SECRET=
# Recomendado: hosts de redirecionamento permitidos para o registo de clientes, separados por vírgulas
# (impede que um atacante registe um cliente a apontar para outro site). Ex.: claude.ai,claude.com,chatgpt.com
ALLOWED_REDIRECT_HOSTS=
# Opcional: data de expiração da chave da Garmin (YYYY-MM-DD) para avisos
GARMIN_KEY_EXPIRES=
